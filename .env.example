# The setup password: entered once on a brand-new install (at /) to make
# the admin account. Keep it to yourself. If unset, a random one is
# generated at startup and printed to the logs. Not needed once the admin
# exists, except for ADMIN_RECOVERY.
ADMIN_PASSWORD=change-me

# Lost every admin passkey AND can't get the emailed code? Set to 1 and
# redeploy: the sign-in page shows "Admin setup", and after the setup
# password your own email can add a passkey. Remove it afterwards.
# ADMIN_RECOVERY=1

# Sign-in codes go out over SMTP. iCloud Mail (custom domain):
#   host smtp.mail.me.com, port 587 (STARTTLS), user = your Apple ID's
#   iCloud address, pass = an app-specific password (appleid.apple.com).
SMTP_HOST=smtp.mail.me.com
SMTP_PORT=587
SMTP_USER=you@icloud.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
# One of the domain's real addresses (iCloud won't send as a wildcard one).
MAIL_FROM=Canopy <account@canopysf.com>

# Where this service is, as sites and links should point at it. Defaults
# to https://account.<CANOPY_DOMAIN> in production.
# PUBLIC_URL=https://account.canopysf.com

# The domain every Canopy site lives under: the cookie, passkeys and the
# ?return= check all use it.
# CANOPY_DOMAIN=canopysf.com

# The Android apps whose passkey sign-ins are accepted, comma-separated:
# each the SHA-256 of the certificate the app is signed with, either as
# keytool prints it (AA:BB:...:FF) or as Android puts it in the passkey's
# origin (base64url, with or without "android:apk-key-hash:"). With Play
# App Signing, the app signing key's, from the Play Console. Empty: no
# Android app is trusted. The iOS app needs nothing here.
# ANDROID_APK_KEY_HASHES=

# Contact details (email, phone, Instagram, Venmo, Cash App) are encrypted
# in the database. Both are base64 of 32 random bytes: openssl rand -base64 32
# CONTACT_ENCRYPTION_KEYS is <id>:<key>, comma-separated; the first one
# encrypts, and any of them decrypts (that's how a key is rotated). Back
# both up somewhere that isn't this server: losing them loses every
# contact detail. Unset, throwaway keys are made for each run (fine for
# development); production refuses to start without them once anyone has
# signed up. See README.md > Contact details at rest.
CONTACT_ENCRYPTION_KEYS=k2026:REPLACE_WITH_openssl_rand_-base64_32
LOOKUP_HMAC_KEY=REPLACE_WITH_openssl_rand_-base64_32
# Only after a key is truly lost: start anyway, and what it encrypted reads
# as empty.
# CONTACT_KEYS_LOST=1

PORT=3000
DATA_DIR=./data
